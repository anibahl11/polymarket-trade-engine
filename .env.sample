# Copy to .env. Never commit .env.

# ---- Safety: simulation is the default ------------------------------------
# Live trading requires BOTH SIMULATION_MODE=false AND the --prod CLI flag.
SIMULATION_MODE=true

# ---- Risk caps (sim AND live) ----------------------------------------------
MAX_POSITION_PCT=0.05          # max single buy as fraction of bankroll
DAILY_LOSS_LIMIT=0             # USD, 0 = disabled
MENTIONS_MAX_MARKET_USD=25     # max exposure per word market
MENTIONS_MAX_EVENT_USD=100     # max exposure per event
MENTIONS_KELLY_FRACTION=0.25   # fractional Kelly sizing
MENTIONS_MIN_EDGE=0.03         # min edge per share after fees
MENTIONS_SNIPE_MAX_PRICE=0.95  # never pay more than this for YES on a hit

# ---- Speech-to-text (live snipe) --------------------------------------------
DEEPGRAM_API_KEY=

# ---- Polymarket live trading -------------------------------------------------
PRIVATE_KEY=                   # 0x-prefixed key of the signing wallet
POLY_FUNDER_ADDRESS=           # Polymarket proxy wallet that holds funds
BUILDER_KEY=                   # Builder API creds (relayer: redeem, wrap)
BUILDER_SECRET=
BUILDER_PASSPHRASE=

# ---- Optional ---------------------------------------------------------------
# DB_PATH=state/mentions.db
# MENTIONS_TAG_SLUG=mention-markets
# SIM_SLIPPAGE_BPS=0
# SIM_PARTIAL_FILL_PROB=0
# SIM_LATENCY_JITTER_MS=0
