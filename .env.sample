# ---- Market selection ----
TICKER=polymarket
MARKET_ASSET=btc
MARKET_WINDOW=5m

# ---- Safety: simulation is the safe default. -----------------------------
# Live trading requires BOTH SIMULATION_MODE=false AND the --prod CLI flag.
# Pass --dry-run to force simulation regardless of env.
SIMULATION_MODE=true
FORCE_PROD=false

# ---- Risk gates (applied in sim AND live) -------------------------------
WALLET_BALANCE=50          # sim starting bankroll
MAX_SESSION_LOSS=3         # shut down when |session loss| >= this (USD)
MAX_POSITION_PCT=0.05      # max single buy as fraction of bankroll (0.05 = 5%)
MAX_DRAWDOWN_PCT=0.20      # shut down when drawdown >= this (0.20 = 20%)
DAILY_LOSS_LIMIT=0         # 0 = disabled; persists across restarts within UTC day

# ---- Sim realism (all default 0 / disabled) ------------------------------
# SIM_DELAY_MS=             # base latency override (ms)
# SIM_LATENCY_JITTER_MS=0   # +/- jitter on top of base latency (ms)
# SIM_BALANCE_DELAY_MS=4000 # delay before sells unlock after a buy fills (ms)
# SIM_PARTIAL_FILL_PROB=0   # probability (0..1) a FOK fills only partially
# SIM_SLIPPAGE_BPS=0        # taker slippage in basis points (e.g. 20 = 0.20%)
# SIM_FEE_BPS=0             # taker fee in basis points (mirrors prod fee bookkeeping)
# SIM_NETWORK_FAIL_PROB=0   # probability (0..1) postOrders returns success:false

# ---- Strategy: momentum-imbalance (paper-trading only) -------------------
# Position sizing: fraction of starting bankroll per trade (also capped by
# the engine's MAX_POSITION_PCT — whichever is smaller wins).
# MI_POSITION_PCT=0.02
# MI_USE_KELLY=false              # if true, scale by 1/4 Kelly within posPct cap
#
# Spot momentum gate
# MI_MOMENTUM_WINDOW_S=60         # look-back window for BTC delta (seconds)
# MI_MOMENTUM_THRESHOLD_USD=30    # min |BTC move| over the window
#
# Order-book gates
# MI_IMBALANCE_THRESHOLD=0.6      # bid_liq / (bid_liq + ask_liq) at top of book
# MI_MIN_LIQUIDITY_USD=50         # min ask-side USDC at top of book
# MI_MAX_ENTRY_PRICE=0.85         # don't pay more than this per share
#
# Time gates
# MI_MIN_REMAINING_S=30           # don't enter inside the last 30s
# MI_MAX_REMAINING_S=240          # don't enter before this many seconds remain
#
# Exit rules
# MI_TAKE_PROFIT_PCT=0.20         # resting GTC sell at entry * (1 + this)
# MI_STOP_LOSS_PCT=0.30           # emergency-sell if best bid <= entry * (1 - this)
#
# Mean-reversion fallback
# MI_REVERSION_REMAINING_S=90     # switch to reversion when remaining <= this
# MI_REVERSION_EXTREME_PRICE=0.85 # only fade when one side's bid >= this
# MI_REVERSION_BTC_DELTA_USD=20   # require BTC reversal of at least this much

# ---- Strategy: btc-gap-fade (simulation only) ----------------------------
# Gap mean-reversion: buys the losing token when the gap fades toward priceToBeat.
# BGF_GAP_THRESHOLD=30        # min |BTC - priceToBeat| to consider entry ($)
# BGF_MIN_ATR=3               # min ATR (BTC volatility/s) to allow entry
# BGF_FADE_RATIO=0.70         # gap must have faded to < this fraction of peak
# BGF_ENTRY_MIN_SECS=60       # earliest entry (seconds remaining)
# BGF_ENTRY_MAX_SECS=240      # latest entry (seconds remaining)
# BGF_TAKE_PROFIT_PRICE=0.55  # GTC resting sell target
# BGF_POSITION_SHARES=5       # USDC budget per trade (shares = floor(budget/ask))

# ---- Strategy: passive-maker (simulation only) ----------------------------
# Passive limit-order maker: posts a resting bid below market to capture spread.
# PM_CERTAINTY_THRESHOLD=0.80 # min token ask price to qualify as high-certainty
# PM_ENTRY_MIN_SECS=60        # don't enter with fewer seconds remaining
# PM_ENTRY_MAX_SECS=90        # don't enter with more seconds remaining
# PM_ENTRY_DISCOUNT=0.02      # bid = bestAsk - discount
# PM_POSITION_SHARES=5        # USDC budget per trade

# ---- Strategy: multi-level-ofi (simulation only) -------------------------
# Multi-level OFI + BTC dislocation gate. FOK taker entry in fee-safe zones.
# MLOFI_OFI_THRESHOLD=20         # min weighted OFI magnitude for a signal
# MLOFI_DISLOC_BTC_PCT=0.0002    # min BTC % move in 30s to count as dislocation
# MLOFI_DISLOC_TOKEN_GAP=0.02    # min token mispricing vs fair value
# MLOFI_FEE_SAFE_MAX=0.40        # upper bound of lower fee-safe zone (price < this)
# MLOFI_FEE_SAFE_MIN=0.60        # lower bound of upper fee-safe zone (price > this)
# MLOFI_TAKE_PROFIT_PCT=0.20     # GTC sell at entry * (1 + this)
# MLOFI_STOP_LOSS_PCT=0.30       # emergency sell if bid <= entry * (1 - this)
# MLOFI_MIN_REMAINING_S=30       # don't enter inside the last N seconds
# MLOFI_MAX_REMAINING_S=240      # don't enter before this many seconds remain
# MLOFI_POSITION_SHARES=5        # USDC budget per trade

# ---- Strategy: late-entry -------------------------------------------------
# Indicator-driven late entry (ATR, gap safety, PGR). Waits for confirmation.
# LE_REMAINING_MAX_S=120    # don't enter with more than this many seconds remaining
# LE_ATR_MAX=5.0            # max ATR (BTC vol/s) to allow entry
# LE_GAP_SAFETY_MIN=10      # min gap-to-ATR safety ratio
# LE_PEAK_GAP_RATIO_MIN=0.50 # min PGR (current/peak gap) to allow entry
# LE_CERTAINTY_MIN=0.60     # min token ask price to count as high-certainty

# ---- Live trading (only used when SIMULATION_MODE=false AND --prod) -----
PRIVATE_KEY=
POLY_FUNDER_ADDRESS=
BUILDER_KEY=
BUILDER_SECRET=
BUILDER_PASSPHRASE=
